{
  "id": "org.example.sample",
  "name": "Sample",
  "version": "1.0",
  "apiVersion": 1,
  "summary": "Remembers the page a command ran on and answers its page script.",
  "permissions": ["clipboard"],
  "sites": ["https://example.org/*"],
  "background": "background.js",
  "contributes": {
    "commands": [
      { "id": "remember", "title": "Remember Page", "symbol": "bookmark", "keywords": ["save"], "shortcut": "ctrl+opt+r" },
      { "id": "probe", "title": "Probe the Sandbox" },
      { "id": "wait", "title": "Wait Forever" }
    ],
    "menus": [
      { "command": "remember", "location": "pageContextMenu", "contexts": ["page", "link"] },
      { "command": "remember", "location": "tabContextMenu", "title": "Remember" }
    ],
    "sidebarItems": [
      { "id": "remembered", "title": "Remembered", "symbol": "bookmark", "command": "remember" }
    ],
    "settings": [
      { "key": "label", "title": "Label", "type": "text", "default": "Remembered" },
      { "key": "limit", "title": "Limit", "type": "number", "default": 5, "min": 1, "max": 10 }
    ],
    "pageScripts": [
      { "matches": ["https://example.org/*"], "excludes": ["https://example.org/private/*"], "js": ["scripts/page.js"], "runAt": "documentEnd" }
    ]
  }
}
