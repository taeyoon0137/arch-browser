          }
        }
      }
    },
    "Only in a tab where you use one of its commands, until the tab leaves the website" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 중 하나를 사용한 탭에서만, 탭이 해당 웹사이트를 벗어날 때까지"
