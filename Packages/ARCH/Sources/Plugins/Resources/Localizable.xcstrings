{
  "sourceLanguage" : "en",
  "strings" : {
    " and " : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 및 "
          }
        }
      }
    },
    "%@ and %lld more" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 외 %2$lld개"
          }
        }
      }
    },
    "%@ and its subdomains" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 및 하위 도메인"
          }
        }
      }
    },
    "%@ cannot run this package, and the other version of “%@” runs on %@ tabs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 이 패키지를 실행할 수 없으며, “%2$@”의 다른 버전은 %3$@ 탭에서 실행됩니다."
          }
        }
      }
    },
    "%@ does not run this version." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 버전을 실행하지 않습니다."
          }
        }
      }
    },
    "%@ does not run “%@”, so it cannot be the %@ version." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 “%2$@” 실행을 지원하지 않으므로 %3$@ 버전이 될 수 없습니다."
          }
        }
      }
    },
    "%@ does not run “%@”, so it cannot keep %@ tabs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 “%2$@” 실행을 지원하지 않으므로 %3$@ 탭을 유지할 수 없습니다."
          }
        }
      }
    },
    "%@ has no key for its extension’s identifier." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 확장 프로그램 식별자에 대한 키가 없습니다."
          }
        }
      }
    },
    "%@ has not checked this package." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 아직 이 패키지를 확인하지 않았습니다."
          }
        }
      }
    },
    "%@ has not checked “%@” yet, so it cannot be the %@ version." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 아직 “%2$@” 확인을 마치지 않아 %3$@ 버전이 될 수 없습니다."
          }
        }
      }
    },
    "%@ holds no .zip archive after its header." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 헤더 뒤에 .zip 아카이브가 없습니다."
          }
        }
      }
    },
    "%@ holds no web extension." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 웹 확장 프로그램이 없습니다."
          }
        }
      }
    },
    "%@ is a .crx file of format version %u, which Chromium no longer installs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 파일은 형식 버전 %2$u의 .crx 파일이며, Chromium에서 더 이상 설치하지 않습니다."
          }
        }
      }
    },
    "%@ is not a .crx file." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일은 .crx 파일이 아닙니다."
          }
        }
      }
    },
    "%@ is not a complete .crx file." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일은 완전한 .crx 파일이 아닙니다."
          }
        }
      }
    },
    "%@ runs no web extensions on this Mac, so no version can run on it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 %@ 엔진은 웹 확장 프로그램을 실행하지 않으므로 어떤 버전도 실행할 수 없습니다."
          }
        }
      }
    },
    "%@ runs no web extensions on this Mac." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 %@ 엔진은 웹 확장 프로그램을 실행하지 않습니다."
          }
        }
      }
    },
    "%@, which you installed from %@, has this package’s identifier, so as its %@ version the package takes over the data that %@ keeps on %@ tabs. Join only if both come from the same developer." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에서 설치한 %1$@의 식별자가 이 패키지와 같으므로, 이 패키지가 %3$@ 버전으로서 %4$@의 %5$@ 탭 데이터를 이어받습니다. 두 항목의 개발자가 같은 경우에만 합치세요."
          }
        }
      }
    },
    "%lld websites" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트 %lld개"
          }
        }
      }
    },
    "A plugin built into Arch has the identifier %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arch에 내장된 플러그인이 이미 %@ 식별자를 사용하고 있습니다."
          }
        }
      }
    },
    "A version of an installed plugin has the identifier %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 플러그인의 한 버전이 이미 %@ 식별자를 사용하고 있습니다."
          }
        }
      }
    },
    "AI wrote a plugin that Arch cannot use. %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 작성한 플러그인을 Arch에서 사용할 수 없습니다. %@"
          }
        }
      }
    },
    "An installed plugin has the identifier this version would take." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전이 사용할 식별자를 설치된 플러그인이 이미 사용하고 있습니다."
          }
        }
      }
    },
    "An installed plugin of another kind has the identifier %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 종류의 설치된 플러그인이 이미 %@ 식별자를 사용하고 있습니다."
          }
        }
      }
    },
    "Another installed plugin has this package’s identifier, so it cannot join “%@” here. Join With… joins installed plugins." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 다른 플러그인이 이 패키지의 식별자를 사용하고 있어 여기서 “%@”에 합칠 수 없습니다. 설치된 플러그인은 ‘다음과 합치기…’로 합치세요."
          }
        }
      }
    },
    "Arch can prove the identifier of only one of the two, and a native app on this Mac accepts the other’s, so they cannot be one plugin." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arch가 둘 중 하나의 식별자만 증명할 수 있고 이 Mac의 네이티브 앱이 다른 하나의 식별자를 허용하므로, 하나의 플러그인으로 합칠 수 없습니다."
          }
        }
      }
    },
    "Arch cannot reach this tab’s page for the plugin without your gesture now." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 사용자의 동작 없이 Arch가 플러그인을 위해 이 탭의 페이지에 접근할 수 없습니다."
          }
        }
      }
    },
    "Arch could not save the plugin list, so changes to it since then last only until Arch quits. %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arch가 플러그인 목록을 저장할 수 없어, 이후의 변경 사항은 Arch를 종료할 때까지만 유지됩니다. %@"
          }
        }
      }
    },
    "Arch keeps a file named %@ beside the installed plugins, so no plugin can have it as its identifier." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arch가 설치된 플러그인 옆에 %@ 파일을 보관하므로, 어떤 플러그인도 이 식별자를 사용할 수 없습니다."
          }
        }
      }
    },
    "Arch keeps identifiers that start with %@ for the plugins built into it, so no plugin can have %@ as its identifier." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 접두사로 시작하는 식별자는 Arch 내장 플러그인용이므로, 어떤 플러그인도 %2$@ 식별자를 사용할 수 없습니다."
          }
        }
      }
    },
    "Arch renames the identifier %@ to %@ at launch, so no plugin can have it as its identifier." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arch가 실행 시 %1$@ 식별자를 %2$@ 식별자로 변경하므로, 어떤 플러그인도 이 식별자를 사용할 수 없습니다."
          }
        }
      }
    },
    "Arch switched the plugin off after it failed three times within five minutes. %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인이 5분 안에 세 번 실패하여 Arch가 플러그인을 껐습니다. %@"
          }
        }
      }
    },
    "Both versions of “%@” have one identifier, which each engine loads only once, so they stay one plugin. Remove a version instead." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 두 버전은 식별자가 같고 각 엔진이 한 번만 불러오므로 하나의 플러그인으로 유지됩니다. 대신 한 버전을 제거하세요."
          }
        }
      }
    },
    "Copies the address of a tab." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭의 주소를 복사합니다."
          }
        }
      }
    },
    "Copies the page’s title with its address, such as [Arch](https://example.com/)." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Arch](https://example.com/)처럼 페이지 제목을 주소와 함께 복사합니다."
          }
        }
      }
    },
    "Copy Address" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
