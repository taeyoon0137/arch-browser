      }
    },
    "Send text to the AI models you connected" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결한 AI 모델에 텍스트 보내기"
          }
        }
      }
    },
    "Sends the text this plugin writes, as you use it and as browser events reach it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인을 사용할 때와 브라우저 이벤트가 전달될 때 이 플러그인이 작성한 텍스트를 보냅니다."
          }
        }
      }
    },
    "Sends the text this plugin writes, as you use it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인을 사용할 때 이 플러그인이 작성한 텍스트를 보냅니다."
          }
        }
      }
    },
    "Show notifications under the plugin's name" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인 이름으로 알림 표시"
          }
        }
      }
    },
    "Suggest names for your tabs" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 이름 제안"
          }
        }
      }
    },
    "The Web Store sent the package of another extension." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 스토어가 다른 확장 프로그램의 패키지를 보냈습니다."
          }
        }
      }
    },
    "The background script left a call unanswered for %@ seconds." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 스크립트가 %@초 동안 호출에 응답하지 않았습니다."
          }
        }
      }
    },
    "The background script’s process ended unexpectedly." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 스크립트의 프로세스가 예기치 않게 종료되었습니다."
          }
        }
      }
    },
    "The command needs a page." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 명령에는 페이지가 필요합니다."
          }
        }
      }
    },
    "The header of %@ could not be read." : {
