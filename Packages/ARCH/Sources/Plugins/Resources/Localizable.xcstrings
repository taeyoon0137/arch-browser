        }
      }
    },
    "Only installed web extensions can be versions of one plugin." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 웹 확장 프로그램만 한 플러그인의 버전이 될 수 있습니다."
