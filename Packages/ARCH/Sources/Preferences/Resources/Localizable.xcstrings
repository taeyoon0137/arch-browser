{
  "sourceLanguage" : "en",
  "strings" : {
    " Arch reads PATH from your login shell once per launch, so quit and reopen Arch after changing it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Arch는 실행할 때마다 로그인 셸에서 PATH를 한 번 읽으므로, PATH를 변경한 후에는 Arch를 종료했다가 다시 여세요."
          }
        }
      }
    },
    " The reply reached the length limit." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 응답이 길이 제한에 도달했습니다."
          }
        }
      }
    },
    " · %lld input and %lld output tokens" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · 입력 %lld, 출력 %lld 토큰"
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ %@ (Web Store)" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@(웹 스토어)"
          }
        }
      }
    },
    "%@ %@ characters" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@자"
          }
        }
      }
    },
    "%@ 1 character" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 1자"
          }
        }
      }
    },
    "%@ A request that names a tier, such as an agent hook’s, uses its model and fallbacks; the features above use the models chosen for them. A tier without a model fails and never uses another tier or the default model." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 에이전트 훅의 요청처럼 등급을 지정한 요청은 해당 등급의 모델과 대체 모델을 사용하고, 위의 기능은 각 기능에 선택된 모델을 사용합니다. 모델이 없는 등급의 요청은 실패하며, 다른 등급이나 기본 모델을 사용하지 않습니다."
          }
        }
      }
    },
    "%@ Copy" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 사본"
          }
        }
      }
    },
    "%@ It runs on its own." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 자동으로 실행됩니다."
          }
        }
      }
    },
    "%@ Tier" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 등급"
          }
        }
      }
    },
    "%@ and %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 및 %2$@"
          }
        }
      }
    },
    "%@ comes first on your PATH and runs instead." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PATH에서 %@ 항목이 먼저 발견되어 대신 실행됩니다."
          }
        }
      }
    },
    "%@ comes first on your PATH and runs instead; Remove, then Install again, to replace it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PATH에서 %@ 항목이 먼저 발견되어 대신 실행됩니다. 교체하려면 제거한 다음 다시 설치하세요."
          }
        }
      }
    },
    "%@ did not run. %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 훅이 실행되지 않았습니다. %2$@"
          }
        }
      }
    },
    "%@ failed: %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 훅 실패: %2$@"
          }
        }
      }
    },
    "%@ holds Arch's skill with changes made after Arch wrote it, so Arch leaves it alone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 위치의 Arch 스킬은 Arch가 작성한 후 변경되었으므로 Arch가 건드리지 않습니다."
          }
        }
      }
    },
    "%@ holds files that Arch did not write, so Arch leaves it alone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 위치에 Arch가 작성하지 않은 파일이 있으므로 Arch가 건드리지 않습니다."
          }
        }
      }
    },
    "%@ input and %@ output tokens" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력 %1$@, 출력 %2$@ 토큰"
          }
        }
      }
    },
    "%@ is already used by %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 단축키는 이미 ‘%2$@’에서 사용 중입니다."
          }
        }
      }
    },
    "%@ is inside an app bundle, whose signature covers its files, so Arch leaves it alone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 위치는 서명이 파일을 보호하는 앱 번들 안에 있으므로 Arch가 건드리지 않습니다."
          }
        }
      }
    },
    "%@ is not in your login shell’s PATH. Install it in the terminal, or choose the file with Choose…." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 셸의 PATH에 %@ 항목이 없습니다. 터미널에서 설치하거나 ‘선택…’으로 파일을 선택하세요."
          }
        }
      }
    },
    "%@ is used by %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 단축키는 ‘%2$@’에서 사용 중입니다."
