      }
    },
    "The Keychain did not record this change, so an earlier copy of agent.json would still open: %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인에 이 변경 사항이 기록되지 않아 이전 agent.json 사본이 계속 열릴 수 있습니다: %@"
