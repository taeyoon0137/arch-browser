  "strings" : {
    "%@ in %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 %1$@"
          }
        }
      }
    },
    "%@ input and %@ output tokens" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력 토큰 %1$@개, 출력 토큰 %2$@개"
          }
        }
      }
    },
    "%@ is not signed in." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
