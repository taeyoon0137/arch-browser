    "%@ runs scripts, and this access covers every script it runs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱은 스크립트를 실행하며, 이 접근 권한은 이 앱이 실행하는 모든 스크립트에 적용됩니다."
          }
        }
      }
    },
    "%@ — %@" : {
