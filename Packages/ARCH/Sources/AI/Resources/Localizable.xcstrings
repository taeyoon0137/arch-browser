    },
    "%@ is at its usage limit until %@. The message starts then; Stop cancels it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 사용량 한도가 %2$@까지입니다. 메시지는 그때 시작되며, 중단을 누르면 취소됩니다."
