      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀 리퀘스트"
          }
        }
      }
    },
    "Review Requests" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리뷰 요청"
          }
        }
      }
    },
    "The GitHub CLI is not installed." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI가 설치되어 있지 않습니다."
          }
        }
      }
    },
    "The GitHub CLI is not signed in to %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI가 %@ 호스트에 로그인되어 있지 않습니다."
          }
        }
      }
    },
    "The Mac is offline." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 오프라인 상태입니다."
          }
        }
      }
    },
    "The feed could not be read: %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드를 읽을 수 없습니다: %@"
          }
        }
      }
    },
    "The feed's address is missing from the Keychain." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인에 피드 주소가 없습니다."
          }
        }
      }
    },
    "The response is larger than %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답이 %@보다 큽니다."
          }
        }
      }
    },
    "The server answered %lld (%@)." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 응답: %lld(%@)."
          }
        }
      }
    },
    "The server's answer is not HTTP." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 응답이 HTTP가 아닙니다."
          }
        }
      }
    },
    "The source did not answer within 30 seconds." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스가 30초 안에 응답하지 않았습니다."
          }
        }
      }
    },
    "This address is not an RSS or Atom feed." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 RSS 또는 Atom 피드가 아닙니다."
          }
        }
      }
    },
    "This is not a web address." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 주소가 아닙니다."
          }
        }
      }
    },
    "gh could not start: %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh를 시작할 수 없습니다: %@"
          }
        }
      }
    },
    "gh exited with status %d." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh가 종료되었습니다(상태 %d)."
          }
        }
      }
    },
    "gh printed an answer Arch cannot read." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh가 Arch에서 읽을 수 없는 응답을 출력했습니다."
          }
        }
      }
    },
    "gh stopped on signal %d." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gh가 중단되었습니다(신호 %d)."
          }
        }
      }
    },
    "it is not well-formed XML." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
