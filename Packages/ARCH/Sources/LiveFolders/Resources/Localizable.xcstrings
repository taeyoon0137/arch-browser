{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is not a GitHub host." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 호스트가 아닙니다: %@"
          }
        }
      }
    },
    "A feed's address cannot hold a user name or password." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드 주소에는 사용자 이름이나 암호를 넣을 수 없습니다."
          }
        }
      }
    },
    "A feed's address starts with https://." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드 주소는 https://로 시작해야 합니다."
          }
        }
      }
    },
    "GitHub Search" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 검색"
          }
        }
      }
    },
    "GitHub's rate limit was reached." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 요청 한도에 도달했습니다."
          }
        }
      }
    },
    "Issues" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
