{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nIf you quit now, changes to your tabs, windows, and sidebar since the last save may be lost." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n지금 종료하면 마지막으로 저장한 이후 탭, 윈도우, 사이드바에서 변경한 내용이 사라질 수 있습니다."
          }
        }
      }
    },
    "%lld downloads have not finished, and a program is running in the terminal. They all stop when Arch quits." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드 %lld개가 끝나지 않았고 터미널에서 프로그램이 실행 중입니다. Arch를 종료하면 모두 중단됩니다."
          }
        }
      }
    },
    "%lld downloads have not finished. They stop when Arch quits." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드 %lld개가 끝나지 않았습니다. Arch를 종료하면 중단됩니다."
          }
        }
      }
    },
    "A download has not finished, and a program is running in the terminal. Both stop when Arch quits." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드 1개가 끝나지 않았고 터미널에서 프로그램이 실행 중입니다. Arch를 종료하면 둘 다 중단됩니다."
          }
        }
      }
    },
    "A download has not finished. It stops when Arch quits." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
